#!/bin/sh

# configure generates src/Makevars and compilation generates these artifacts.
# Keep the source package clean after INSTALL/check/build.
rm -f src/Makevars src/*.o src/*.so src/symbols.rds config.log config.status

# Autoconf and R CMD check create local development directories.  They are
# reproducible build artifacts and must not remain in the package source tree.
rm -rf autom4te.cache ResTree.Rcheck

# R CMD build writes its tarball into the caller's working directory.  The
# documented workflow invokes it from the parent directory, but remove a
# same-version tarball if a developer accidentally builds from here.
restree_version=$(sed -n 's/^Version: *//p' DESCRIPTION)
case "$restree_version" in
  ''|*[!0-9A-Za-z.-]*) ;;
  *) rm -f "ResTree_${restree_version}.tar.gz" ;;
esac
